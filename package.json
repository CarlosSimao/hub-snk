{
  "name": "sankhya-hub",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Painel de monitoramento do ambiente local do Sankhya: WildFly + Oracle",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "build:web": "vite build",
    "start": "node dist/index.js",
    "app": "npm --prefix desktop run start",
    "test": "node --test \"test/*.test.ts\" \"test/checks/*.test.ts\"",
    "test:watch": "node --test --watch \"test/*.test.ts\" \"test/checks/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.test.json && tsc -p web/tsconfig.json"
  },
  "dependencies": {
    "@fastify/static": "^8.2.0",
    "fastify": "^5.4.0",
    "nodemailer": "^10.0.10",
    "oracledb": "^7.0.1",
    "yaml": "^2.8.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/nodemailer": "^8.0.2",
    "@types/oracledb": "^7.0.2",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "pino-pretty": "^13.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.2",
    "vite": "^7.3.6"
  }
}
