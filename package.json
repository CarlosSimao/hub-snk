{
  "name": "hub-snk",
  "version": "1.1.0",
  "private": true,
  "description": "HUB SNK — cadastro de clientes e ambiente Sankhya, em aplicativo desktop (Electron)",
  "author": "Carlos Nascimento <carlos.nascimento@sankhya.com.br>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CarlosSimao/hub-snk.git"
  },
  "bugs": {
    "url": "https://github.com/CarlosSimao/hub-snk/issues"
  },
  "homepage": "https://github.com/CarlosSimao/hub-snk#readme",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --watch src/index.ts",
    "start": "node src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test",
    "formatar": "prettier --write .",
    "conferir-formato": "prettier --check .",
    "app": "npm --prefix desktop start",
    "empacotar-desktop": "npm --prefix desktop run empacotar"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "fastify": "^5.12.1",
    "pino-pretty": "^13.1.1",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  }
}
