{
  "name": "sankhya-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Painel de monitoramento do ambiente local do Sankhya: WildFly + Oracle",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "node --test \"test/*.test.ts\" \"test/checks/*.test.ts\"",
    "test:watch": "node --test --watch \"test/*.test.ts\" \"test/checks/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@fastify/static": "^8.2.0",
    "fastify": "^5.4.0",
    "oracledb": "^7.0.1",
    "yaml": "^2.8.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/oracledb": "^7.0.2",
    "@types/pg": "^8.15.5",
    "pino-pretty": "^13.1.1",
    "typescript": "^5.9.2"
  }
}
