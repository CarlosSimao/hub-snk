{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // Os imports usam extensao .ts para o Node rodar o fonte direto (type stripping);
    // na emissao o TS reescreve para .js, entao o dist/ fica com specifiers validos.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    // O `npm run dev` roda o fonte pelo type stripping do Node, que so apaga tipos —
    // enum, namespace e parameter property compilam no tsc e estouram em runtime.
    // Com isto o typecheck reprova essas construcoes antes de virem a ser um boot quebrado.
    "erasableSyntaxOnly": true,
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "sourceMap": true,
    "declaration": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": false,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts"]
}
