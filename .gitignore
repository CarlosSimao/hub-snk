node_modules/
dist/
*.log

# Saída do `vite build` — o painel é versionado em `web/`, não aqui.
/public/

# O cofre de credenciais vive aqui (data/segredos.json). Nunca versionar.
data/

# O hub não usa arquivo .env — a configuração é pelo painel. Estas entradas ficam
# como rede de segurança: se um .env for criado por hábito, não vai para o repositório.
.env
.env.*
!.env.example

# Launcher gerado por scripts/compilar-launcher.ps1.
bin/

# Instaladores gerados pelo electron-builder (desktop/electron-builder.yml).
/release/
