# Mantém o mesmo recuo e final de linha em qualquer editor, para o projeto ser
# clonado em Windows, Linux e macOS sem diferença de formatação.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Em Markdown, dois espaços no fim da linha são uma quebra de linha.
[*.md]
trim_trailing_whitespace = false

# Scripts que o instalador roda no Windows PowerShell 5.1: CRLF, como manda o
# .gitattributes, e UTF-8 com BOM, sem o qual ele lê os acentos como ANSI.
[*.ps1]
end_of_line = crlf
charset = utf-8-bom
